{
  "name": "example",
  "ci": {
    "browserSuites": [
      "test:screens",
      "test:e2e"
    ],
    "emulatorSecrets": {
      "SENTRY_DSN": "disabled",
      "APNS_KEY": "unused-in-emulator"
    },
    "knip": true,
    "ffmpeg": true,
    "mediaStore": true
  },
  "build": {
    "sentryDsnVariable": "EXPO_PUBLIC_SENTRY_DSN_NATIVE"
  },
  "ios": {
    "backgroundPlayback": true
  },
  "emulators": {
    "base": 61900,
    "project": "demo-example",
    "extras": { "store": 20, "storeAdmin": 21 },
    "functionsWrapper": ["with-store"]
  }
}
